<script>
(function () {
  'use strict';

  var kok = document.documentElement;
  var dilDugmesi = document.getElementById('dilDugmesi');
  var dilEtiketi = document.getElementById('dilEtiketi');
  var temaDugmesi = document.getElementById('temaDugmesi');
  var temaSimge = document.getElementById('temaSimge');

  var AY = '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>';
  var GUNES = '<circle cx="12" cy="12" r="4"/>'
    + '<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4'
    + 'M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>';

  /** Tarayici deposu ozel modda erisilemeyebilir; sessizce gec. */
  function oku(anahtar) {
    try { return localStorage.getItem(anahtar); } catch (e) { return null; }
  }
  function yaz(anahtar, deger) {
    try { localStorage.setItem(anahtar, deger); } catch (e) { /* yok say */ }
  }

  function dilUygula(dil) {
    kok.setAttribute('lang', dil);
    document.title = dil === 'tr'
      ? 'SAM GPS Map Camera — Gizlilik Politikası'
      : 'SAM GPS Map Camera — Privacy Policy';
    // Dugme karsi dili gosterir: Turkce sayfadayken "English" yazar.
    dilEtiketi.textContent = dil === 'tr' ? 'English' : 'Türkçe';
  }

  function temaUygula(tema) {
    kok.setAttribute('data-tema', tema);
    temaSimge.innerHTML = tema === 'koyu' ? GUNES : AY;
    var etiketler = temaDugmesi.querySelectorAll('[data-dil]');
    for (var i = 0; i < etiketler.length; i++) {
      var d = etiketler[i].getAttribute('data-dil');
      etiketler[i].textContent = tema === 'koyu'
        ? (d === 'tr' ? 'Gündüz' : 'Light')
        : (d === 'tr' ? 'Gece' : 'Dark');
    }
  }

  // Baslangic: kayitli tercih, yoksa tarayici diline ve sistem temasina bak.
  var kayitliDil = oku('sam.dil');
  var baslangicDil = kayitliDil
    || ((navigator.language || 'en').toLowerCase().indexOf('tr') === 0 ? 'tr' : 'en');
  dilUygula(baslangicDil);

  var kayitliTema = oku('sam.tema');
  var karanlikMi = window.matchMedia
    && window.matchMedia('(prefers-color-scheme: dark)').matches;
  temaUygula(kayitliTema || (karanlikMi ? 'koyu' : 'acik'));

  dilDugmesi.addEventListener('click', function () {
    var yeni = kok.getAttribute('lang') === 'tr' ? 'en' : 'tr';
    dilUygula(yeni);
    yaz('sam.dil', yeni);
  });

  temaDugmesi.addEventListener('click', function () {
    var yeni = kok.getAttribute('data-tema') === 'koyu' ? 'acik' : 'koyu';
    temaUygula(yeni);
    yaz('sam.tema', yeni);
  });

  // Icindekiler: goruntulenen bolumu isaretle.
  var baglar = document.querySelectorAll('.icindekiler a');
  var bolumler = document.querySelectorAll('.bolum');

  if ('IntersectionObserver' in window) {
    var gozlemci = new IntersectionObserver(function (girisler) {
      girisler.forEach(function (giris) {
        if (!giris.isIntersecting) return;
        var kimlik = giris.target.id;
        for (var i = 0; i < baglar.length; i++) {
          var hedefMi = baglar[i].getAttribute('href') === '#' + kimlik;
          baglar[i].classList.toggle('etkin', hedefMi);
        }
      });
    }, { rootMargin: '-15% 0px -70% 0px' });

    for (var i = 0; i < bolumler.length; i++) gozlemci.observe(bolumler[i]);
  }
})();
</script>

