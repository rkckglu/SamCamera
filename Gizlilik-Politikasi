<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>SAM GPS Map Camera — Gizlilik Politikası</title>
<meta name="description" content="SAM GPS Map Camera gizlilik politikası. Verileriniz cihazınızda kalır." />

<style>
  :root {
    color-scheme: light dark;

    --zemin:        #F4F7FA;
    --kart:         #FFFFFF;
    --kart-ust:     #EDF2F7;
    --metin:        #16232E;
    --metin-orta:   #4A5C6B;
    --metin-soluk:  #76889A;
    --cizgi:        #DDE5EC;
    --mavi:         #1063AE;
    --mavi-acik:    #2E8BD8;
    --mavi-zemin:   #E7F0F9;
    --yesil:        #1F7A5C;
    --yesil-zemin:  #E3F3EC;
    --amber:        #9A6208;
    --amber-zemin:  #FBF0DC;

    --olcu:  1.5rem;
    --yuvar: 10px;

    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  :root[data-tema="koyu"] {
    --zemin:        #0C141C;
    --kart:         #131F2A;
    --kart-ust:     #1A2A38;
    --metin:        #E6EDF3;
    --metin-orta:   #A8BAC9;
    --metin-soluk:  #6E8496;
    --cizgi:        #233443;
    --mavi:         #4FA3E3;
    --mavi-acik:    #7CC0F0;
    --mavi-zemin:   #16293C;
    --yesil:        #5FD1A6;
    --yesil-zemin:  #122C25;
    --amber:        #E0B061;
    --amber-zemin:  #2C2416;
  }

  * { box-sizing: border-box; }

  html { scroll-padding-top: 88px; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    * { animation: none !important; transition: none !important; }
  }

  body {
    margin: 0;
    background: var(--zemin);
    color: var(--metin);
    font-family: "Segoe UI", system-ui, -apple-system, Roboto, "Helvetica Neue", sans-serif;
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  /* ---------- Ust cubuk ---------- */
  .ust {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--zemin) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--cizgi);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .ust-ic {
    max-width: 68rem;
    margin: 0 auto;
    padding: 0.75rem var(--olcu);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .marka {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    min-width: 0;
  }
  .marka-simge {
    width: 34px; height: 34px;
    border-radius: 9px;
    background: linear-gradient(145deg, #1B4C8C, #1673C4);
    display: grid; place-items: center;
    flex: none;
  }
  .marka-simge svg { width: 20px; height: 20px; }
  .marka-ad {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .marka-alt {
    display: block;
    font-weight: 500;
    font-size: 0.72rem;
    color: var(--metin-soluk);
  }

  .dugmeler { display: flex; gap: 0.4rem; flex: none; }
  .dugme {
    appearance: none;
    border: 1px solid var(--cizgi);
    background: var(--kart);
    color: var(--metin-orta);
    border-radius: 8px;
    padding: 0.42rem 0.7rem;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: border-color 0.15s, color 0.15s;
  }
  .dugme:hover { border-color: var(--mavi); color: var(--mavi); }
  .dugme:focus-visible { outline: 2px solid var(--mavi); outline-offset: 2px; }
  .dugme svg { width: 15px; height: 15px; }

  /* ---------- Govde duzeni ---------- */
  .sayfa {
    max-width: 68rem;
    margin: 0 auto;
    padding: 0 var(--olcu) 5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 62rem) {
    .sayfa {
      grid-template-columns: 15rem 1fr;
      align-items: start;
      gap: 3.5rem;
    }
    .icindekiler { position: sticky; top: 5.5rem; }
  }

  /* ---------- Baslik ---------- */
  .kapak {
    grid-column: 1 / -1;
    padding: 3.25rem 0 2rem;
    border-bottom: 1px solid var(--cizgi);
    margin-bottom: 0.5rem;
  }
  .kapak h1 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 750;
  }
  .kapak p {
    margin: 0;
    max-width: 44rem;
    color: var(--metin-orta);
    font-size: 1.05rem;
  }
  .tarih {
    display: inline-block;
    margin-top: 1.1rem;
    font-size: 0.82rem;
    color: var(--metin-soluk);
    border: 1px solid var(--cizgi);
    border-radius: 99px;
    padding: 0.22rem 0.75rem;
  }

  /* ---------- Ozet seridi ---------- */
  .ozet {
    display: grid;
    gap: 0.7rem;
    margin: 2rem 0 0;
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    .ozet { grid-template-columns: repeat(3, 1fr); }
  }
  .ozet-kart {
    background: var(--yesil-zemin);
    border: 1px solid color-mix(in srgb, var(--yesil) 24%, transparent);
    border-radius: var(--yuvar);
    padding: 0.9rem 1rem;
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .ozet-kart svg { width: 18px; height: 18px; flex: none; margin-top: 2px; color: var(--yesil); }
  .ozet-kart b { display: block; font-size: 0.9rem; color: var(--metin); }
  .ozet-kart span { font-size: 0.82rem; color: var(--metin-orta); line-height: 1.5; }

  /* ---------- Icindekiler ---------- */
  .icindekiler h2 {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--metin-soluk);
    margin: 0 0 0.75rem;
    letter-spacing: 0.02em;
  }
  .icindekiler ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--cizgi);
  }
  .icindekiler a {
    display: block;
    padding: 0.36rem 0 0.36rem 0.9rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    color: var(--metin-orta);
    text-decoration: none;
    font-size: 0.88rem;
    transition: color 0.15s, border-color 0.15s;
  }
  .icindekiler a:hover { color: var(--mavi); }
  .icindekiler a.etkin {
    color: var(--mavi);
    border-left-color: var(--mavi);
    font-weight: 650;
  }
  .icindekiler a:focus-visible { outline: 2px solid var(--mavi); outline-offset: 2px; }

  /* ---------- Metin ---------- */
  .icerik { min-width: 0; max-width: 44rem; }
  .bolum { padding-top: 2.5rem; }
  .bolum:first-child { padding-top: 0.5rem; }
  .bolum h2 {
    font-size: 1.32rem;
    letter-spacing: -0.015em;
    margin: 0 0 0.85rem;
    font-weight: 700;
  }
  .bolum h3 {
    font-size: 1rem;
    margin: 1.6rem 0 0.5rem;
    font-weight: 650;
  }
  .bolum p { margin: 0 0 0.9rem; color: var(--metin-orta); }
  .bolum ul { margin: 0 0 0.9rem; padding-left: 1.15rem; color: var(--metin-orta); }
  .bolum li { margin-bottom: 0.45rem; }
  .bolum strong { color: var(--metin); font-weight: 650; }
  .bolum a { color: var(--mavi); }

  /* ---------- Izin tablosu ---------- */
  .tablo-sarma {
    overflow-x: auto;
    border: 1px solid var(--cizgi);
    border-radius: var(--yuvar);
    margin: 1.25rem 0 1.5rem;
    background: var(--kart);
  }
  table { width: 100%; border-collapse: collapse; font-size: 0.88rem; min-width: 34rem; }
  thead th {
    background: var(--kart-ust);
    text-align: left;
    padding: 0.7rem 0.9rem;
    font-weight: 650;
    font-size: 0.8rem;
    color: var(--metin-orta);
    border-bottom: 1px solid var(--cizgi);
    white-space: nowrap;
  }
  tbody td {
    padding: 0.8rem 0.9rem;
    border-bottom: 1px solid var(--cizgi);
    color: var(--metin-orta);
    vertical-align: top;
  }
  tbody tr:last-child td { border-bottom: none; }
  tbody td:first-child { color: var(--metin); font-weight: 600; white-space: nowrap; }
  .rozet {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 650;
    padding: 0.12rem 0.5rem;
    border-radius: 5px;
    white-space: nowrap;
  }
  .rozet-cihaz { background: var(--yesil-zemin); color: var(--yesil); }
  .rozet-net   { background: var(--amber-zemin); color: var(--amber); }

  /* ---------- Vurgu kutusu ---------- */
  .kutu {
    border: 1px solid var(--cizgi);
    border-left: 3px solid var(--mavi);
    background: var(--mavi-zemin);
    border-radius: var(--yuvar);
    padding: 1rem 1.1rem;
    margin: 1.25rem 0;
  }
  .kutu p:last-child { margin-bottom: 0; }
  .kutu p { color: var(--metin-orta); font-size: 0.93rem; }

  /* ---------- Iletisim ---------- */
  .iletisim {
    margin-top: 1rem;
    border: 1px solid var(--cizgi);
    border-radius: var(--yuvar);
    background: var(--kart);
    padding: 1.2rem 1.3rem;
  }
  .iletisim p { margin: 0 0 0.4rem; }
  .iletisim p:last-child { margin: 0; }

  footer {
    grid-column: 1 / -1;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--cizgi);
    color: var(--metin-soluk);
    font-size: 0.83rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
  }

  [data-dil] { display: none; }
  html[lang="tr"] [data-dil="tr"] { display: revert; }
  html[lang="en"] [data-dil="en"] { display: revert; }
</style>
</head>

